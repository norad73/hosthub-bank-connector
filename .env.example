# Every variable here is optional when you use the setup page on first run.
# Set them to configure by environment instead; they take precedence.

# --- Enable Banking application (https://enablebanking.com/cp/applications) ---
EB_APP_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
EB_PRIVATE_KEY_PATH=./secrets/enablebanking.pem
# EB_PRIVATE_KEY=

# --- This server ---
BASE_URL=https://bankconnector.onrender.com
PORT=8080

# Password for /balances login. Recommended: scrypt hash from `npm run hash-password`.
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=

# APP_NAME=BankConnector
DEFAULT_COUNTRY=GR
DATA_DIR=./data

# GOOGLE_SHEETS_WEBHOOK_URL=
# CRON_SECRET=

# --- Viva Wallet (optional) ---
# VIVA_MERCHANT_ID=
# VIVA_API_KEY=
# Account Transactions credentials (for Fill Viva transactions; separate from Merchant ID/API Key)
# VIVA_ACCOUNT_CLIENT_ID=
# VIVA_ACCOUNT_CLIENT_SECRET=
# Data Services credentials (Viva-issued; for POST /dataservices/v2/accounttransactions/Search)
# VIVA_DATA_SERVICES_CLIENT_ID=
# VIVA_DATA_SERVICES_CLIENT_SECRET=

# --- Airwallex (optional) ---
# AIRWALLEX_CLIENT_ID=
# AIRWALLEX_API_KEY=
# AIRWALLEX_ACCOUNT_ID=

# --- Stripe (optional) ---
# STRIPE_SECRET_KEY=

# --- PayPal (optional) ---
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=

# --- Mercury (optional) ---
# MERCURY_API_TOKEN=secret-token:mercury_production_...

# --- Cledara (optional) ---
# CLEDARA_API_TOKEN=

# --- Wise (optional; replaces Enable Banking for Wise) ---
# WISE_API_TOKEN=
# WISE_PROFILE_ID=
# WISE_ACCOUNT_LABEL=Hosthub, Inc.
